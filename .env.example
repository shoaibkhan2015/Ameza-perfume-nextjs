# Copy to .env for local development, and add the same values in Vercel → Project → Settings → Environment Variables
# --- Server side (keep secret) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SHIPPING_FEE=250
FREE_SHIPPING_OVER=5000
# --- Order email notifications (Resend) ---
RESEND_API_KEY=re_your_resend_api_key
ORDER_NOTIFICATION_EMAIL=you@example.com
EMAIL_FROM="Améza Orders <onboarding@resend.dev>"
# --- Browser side (public, baked in at build time) ---
# The older VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY / VITE_WHATSAPP_NUMBER names also still work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_WHATSAPP_NUMBER=+923472803606
